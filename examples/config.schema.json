{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config",
  "type": "object",
  "properties": {
    "migrate": {
      "description": "What to do when a repository still has a repo-local ledger that belongs in the central store.",
      "default": "prompt",
      "allOf": [
        {
          "$ref": "#/definitions/MigrateMode"
        }
      ]
    },
    "roots": {
      "description": "Bounded directories searched by cross-repository commands.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/DiscoveryRoot"
      }
    },
    "store_root": {
      "description": "Per-user central store (general + per-repo ledgers). Defaults to `$XDG_DATA_HOME/mmry`.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "sync": {
      "description": "Git sync of the store (`mmry sync init` sets it up).",
      "default": {
        "auto_commit": false,
        "auto_pull": false,
        "auto_push": false,
        "timeout_secs": 10
      },
      "allOf": [
        {
          "$ref": "#/definitions/SyncConfig"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DiscoveryRoot": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "max_depth": {
          "default": 2,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "MigrateMode": {
      "description": "Handling of repo-local ledgers in central mode.",
      "oneOf": [
        {
          "description": "Migrate automatically on first use in that repository.",
          "type": "string",
          "enum": [
            "auto"
          ]
        },
        {
          "description": "Ask on a terminal; otherwise warn and continue without migrating.",
          "type": "string",
          "enum": [
            "prompt"
          ]
        },
        {
          "description": "Never migrate automatically; warn and use the central store only.",
          "type": "string",
          "enum": [
            "off"
          ]
        }
      ]
    },
    "SyncConfig": {
      "description": "Automatic git sync; all off by default. Failures only warn.",
      "type": "object",
      "properties": {
        "auto_commit": {
          "description": "Commit the store after every write.",
          "default": false,
          "type": "boolean"
        },
        "auto_pull": {
          "description": "Pull at session start (`mmry preview`).",
          "default": false,
          "type": "boolean"
        },
        "auto_push": {
          "description": "Push after an automatic commit.",
          "default": false,
          "type": "boolean"
        },
        "timeout_secs": {
          "description": "Upper bound for each git network operation, in seconds.",
          "default": 10,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
