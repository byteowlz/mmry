{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config",
  "type": "object",
  "properties": {
    "roots": {
      "description": "Bounded directories searched by cross-repository commands.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/DiscoveryRoot"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DiscoveryRoot": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "max_depth": {
          "default": 2,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
