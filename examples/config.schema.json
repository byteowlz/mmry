{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roots": {
      "description": "Bounded directories searched by cross-repository commands.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "max_depth": { "type": "integer", "format": "uint", "minimum": 0, "default": 2 }
        }
      }
    }
  }
}
